# Environment Variables — Perpusjal v3

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/perpusjal_db?schema=public"

# App & API Ports
PORT=4000
API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secrets
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"
SESSION_SECRET="super-secret-session-key-replace-in-production"

# Admin Initial Seed
ADMIN_INITIAL_EMAIL="admin@perpusjal.org"
ADMIN_INITIAL_PASSWORD="AdminPerpusjal2026!"
ADMIN_INITIAL_NAME="Pengurus Perpusjal Blora"
ADMIN_INITIAL_USERNAME="admin"

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME="perpusjal"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend (Transactional Emails)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="halo@perpusjal.org"
