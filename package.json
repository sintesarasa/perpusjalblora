{
  "name": "perpusjal-monorepo",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:api": "pnpm db:generate && turbo run build --filter=@perpusjal/api",
    "build:web": "turbo run build --filter=@perpusjal/web",
    "start:api": "pnpm --filter @perpusjal/api start",
    "start:web": "pnpm --filter @perpusjal/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "pnpm --filter api exec tsx ../../prisma/seed.ts",
    "test:e2e": "pnpm --filter @perpusjal/web test:e2e"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3"
  }
}
